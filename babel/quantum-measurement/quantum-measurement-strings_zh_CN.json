  "averagePolarizationDialog.explanatoryParagraph": {
    "value": "该方程给出一个介于 +1 和 -1 之间的值。该值表示检测到的光子偏振的加权平均值，其中每次检测到垂直偏振映射为 +1，每次检测到水平偏振映射为 -1。该值也可以表示为介于 +1 和 -1 之间的矢量表示。",
    "history": [
      {
        "userId": 0,
        "timestamp": 1773334429313,
        "oldValue": "",
