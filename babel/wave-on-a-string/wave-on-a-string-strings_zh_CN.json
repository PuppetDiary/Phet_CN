  "a11y": {
    "screenSummary": {
      "playArea": {
        "value": "通过操作一条紧绑在游戏区域上的绳子来探索波的物理性质。用扳手自己移动绳子，使用连续振荡器，或脉冲绳子来产生波。每种波模式都提供不同的选项来调整绳子的属性和运动，这会影响你创建和观察到的波。绳子的末端可以固定在游戏区域的末端，松开放置，或完全移除以无限延伸。"
      },
      "controlArea": {
        "value": "提供多种工具来支持对产生的波的属性的测量。"
      },
      "interactionHint": {
        "value": "{ $mode ->\n  [manual] 移动扳手或选择另一种方式开始产生波。\n  [oscillate] 启动振荡器或选择另一种方式开始产生波。\n *[pulse] 启动脉冲或选择另一种方式开始产生波。\n}"
      }
    },
    "headings": {
      "playArea": {
        "waveGeneration": {
          "value": "波的产生"
        },
        "activeMeasurementTools": {
          "value": "活动的测量工具"
        },
        "activeMeasurementToolsDescription": {
          "value": "用于可视化测量波属性的工具。暂停模拟以帮助进行精确测量。"
        },
        "waveAndStringProperties": {
          "value": "波和绳子属性"
        },
        "waveAndStringPropertiesDescription": {
          "value": "控制生成的波和绳子的属性。"
        }
      },
      "controlArea": {
        "measurementTools": {
          "value": "测量工具"
        },
        "measurementToolsDescription": {
          "value": "用于可视化测量波属性的工具。暂停模拟以帮助进行精确测量。"
        }
      }
    },
    "valuePatterns": {
      "centimeters": {
